####### Compile

About.o: ../../dialogs/About.cpp ../../dialogs/About.h \
		../../ui_about.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o About.o ../../dialogs/About.cpp

MainWindow.o: ../../dialogs/MainWindow.cpp ../../ticker/TickerRefreshThread.h \
		../../ui_mainwindow.h \
		../../dialogs/MainWindow.h \
		../../dialogs/About.h \
		../../dialogs/SettingsDialog.h \
		../../ticker/Ticker.h \
		../../file/File.h \
		../../ticker/TickerItem.h \
		../../ticker/TickerInfoDownloader.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o MainWindow.o ../../dialogs/MainWindow.cpp

SettingsDialog.o: ../../dialogs/SettingsDialog.cpp ../../file/File.h \
		../../dialogs/SettingsDialog.h \
		../../ui_settingsdialog.h \
		../../ticker/Ticker.h \
		../../ticker/TickerItem.h \
		../../ticker/TickerInfoDownloader.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o SettingsDialog.o ../../dialogs/SettingsDialog.cpp

File.o: ../../file/File.cpp ../../file/File.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o File.o ../../file/File.cpp

main.o: ../../main.cpp ../../dialogs/MainWindow.h \
		../../dialogs/About.h \
		../../dialogs/SettingsDialog.h \
		../../ticker/Ticker.h \
		../../file/File.h \
		../../ticker/TickerItem.h \
		../../ticker/TickerInfoDownloader.h
